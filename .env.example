## Example .env for realtime_service
# You can copy the full connection string from live_tracker/.env into a .env here,
# or rely on the live_tracker/.env which this service will load automatically.

# Full MongoDB connection string (Atlas example). Keep this secret; do NOT commit real credentials.
# MONGO_URI="mongodb+srv://<username>:<password>@cluster0.abcd1.mongodb.net/?retryWrites=true&w=majority"

# Optional: database name (if omitted the service will attempt to read live_tracker/config.yaml)
# MONGO_DB_NAME=td_stock_tracker

# FastAPI listen host/port
HOST=0.0.0.0
PORT=8001
